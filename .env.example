# Optional: T3 Connect source builds
# `cp .env.example .env` enables T3 Connect against the production deployment.
# These are public identifiers baked into official release builds, not secrets.
# For server/web builds, omit them from .env to disable cloud features.
# Mobile uses this file as a default; opt out with MOBILE_CONNECT_ENABLED=false.
# Do not add server-side secrets to this file.

T3CODE_CLERK_PUBLISHABLE_KEY=pk_live_Y2xlcmsudDMuY29kZXMk
T3CODE_CLERK_JWT_TEMPLATE=t3-relay
T3CODE_CLERK_CLI_OAUTH_CLIENT_ID=hzxSgY2cH10sDU2r
T3CODE_RELAY_URL=https://relay.t3.codes

# Native callback for the production Connect deployment.
# This is an OAuth callback alias, not this fork's bundle ID or keychain identity.
# For another Clerk deployment, use a callback authorized by that instance.
MOBILE_CLERK_IOS_REDIRECT_URL=com.t3tools.t3code://callback

# Optional: hosted app origin used by the CLI OAuth flow.
# Defaults to https://app.t3.codes.
# T3CODE_HOSTED_APP_URL=https://app.t3.codes

# Owned mobile builds enable T3 Connect using these public defaults, alongside Direct Connect.
# Root .env/.env.local and EAS environment values override the defaults.
# Set MOBILE_CONNECT_ENABLED=false for a Direct Connect-only mobile build.
# Push, telemetry, and OTA remain disabled independently of Connect.
# Local Xcode/Android builds do not need an Expo account.
# This fork defaults to @ronakguliani/t3-code-rg and the owner's Apple team.
# To build under a different Expo account, override BOTH values in root .env.local
# and the selected EAS environment. Never reuse upstream's project or signing team.
# MOBILE_EAS_OWNER=your-expo-account
# MOBILE_EAS_PROJECT_ID=your-expo-project-uuid
# MOBILE_APPLE_TEAM_ID=YOURTEAMID

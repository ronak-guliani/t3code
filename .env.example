# Optional: T3 Connect source builds
# `cp .env.example .env` enables T3 Connect against the production deployment.
# These are public identifiers baked into official release builds, not secrets.
# Remove or comment them out to build with cloud features disabled.
# Do not add server-side secrets to this file.

T3CODE_CLERK_PUBLISHABLE_KEY=pk_live_Y2xlcmsudDMuY29kZXMk
T3CODE_CLERK_JWT_TEMPLATE=t3-relay
T3CODE_CLERK_CLI_OAUTH_CLIENT_ID=hzxSgY2cH10sDU2r
T3CODE_RELAY_URL=https://relay.t3.codes

# Optional: hosted app origin used by the CLI OAuth flow.
# Defaults to https://app.t3.codes.
# T3CODE_HOSTED_APP_URL=https://app.t3.codes

# Owned mobile builds use Direct Connect and ignore the hosted-service values above.
# Local Xcode/Android builds do not need an Expo account.
# For EAS, set BOTH values in root .env.local and the selected EAS environment.
# Create your own Expo project with slug t3-code-rg; never reuse upstream's project.
# MOBILE_EAS_OWNER=your-expo-account
# MOBILE_EAS_PROJECT_ID=your-expo-project-uuid
